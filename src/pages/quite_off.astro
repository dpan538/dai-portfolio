---
import BaseLayout from "../layouts/base_layout.astro";
import ProjectSemanticInfo from "../components/ProjectSemanticInfo.astro";
import imageDimensions from "../data/image-dimensions.json";

const images = [
    "/projects/quite_off/quite_01.jpg",
    "/projects/quite_off/quite_02.jpg",
    "/projects/quite_off/quite_03.jpg",
    "/projects/quite_off/quite_04.jpg",
    "/projects/quite_off/quite_05.jpg",
    "/projects/quite_off/quite_06.jpg",
    "/projects/quite_off/quite_07.jpg",
    "/projects/quite_off/quite_08.jpg",
];

const imageSemanticMap: Record<number, string[]> = {
    0: ["gaze", "eyes", "beginning", "presence"],
    1: ["distance", "touch", "silence"],
    2: ["distance", "mother", "closeness"],
    3: ["red", "bloom", "gravity"],
    4: ["red", "persistence"],
    5: ["fracture", "motion", "crossing"],
    6: ["departure", "instability"],
    7: ["absence", "afterimage", "memory"],
};

const seoDescription =
    "Quite Off by Dai Pan is an unfinished film fragment and image-based work shot on Kodak Vision3 5203, 5207, and 5219. The project studies gaze, separation, motherhood, friendship, and the red-green motif through photography, writing, and visual art.";
const ogImagePath = "/projects/quite_off/quite_01.jpg";
const SITE_URL = "https://daipan.art";
const projectMeta = {
    name: "Quite Off",
    schemaType: "VisualArtwork",
    year: "2025",
    medium: "Kodak Vision3 film photography, writing, and unfinished film fragment",
    artform: "Film photography and image-based visual art",
    location: "New York / China",
    description: seoDescription,
    images,
    imageAlt: "Quite Off by Dai Pan, a Kodak Vision3 film still from an unfinished image-based work.",
    keywords: ["Quite Off", "Dai Pan film photography", "Kodak Vision3", "unfinished film", "image-based work", "visual art", "photography", "writing", "motherhood", "red-green motif"],
};

const imageSizes = "(max-width: 900px) 90vw, 60vw";
const imageData = images.map((src, index) => {
    const data = imageDimensions[src as keyof typeof imageDimensions];
    const srcset = data?.srcset?.map(({ url, w }) => `${url} ${w}w`).join(", ");
    const fallback = data?.srcset?.find(({ w }) => w === 1280)?.url
        ?? data?.srcset?.[data.srcset.length - 1]?.url
        ?? src;

    return {
        original: src,
        src: fallback,
        srcset,
        sizes: imageSizes,
        width: data?.width,
        height: data?.height,
        alt: `Quite Off by Dai Pan, Kodak Vision3 film still ${String(index + 1).padStart(2, "0")}`,
    };
});

const qoRuntimeData = {
    images: imageData.map(({ src, srcset, sizes, width, height, alt }) => ({ src, srcset, sizes, width, height, alt })),
    semanticMap: imageSemanticMap,
};
---

<BaseLayout
    title="Quite Off — Film Photography & Visual Art by Dai Pan"
    description={seoDescription}
    canonical={`${SITE_URL}/quite_off`}
    ogImage={ogImagePath}
    ogImageAlt={projectMeta.imageAlt}
    ogType="article"
    active="quite_off"
    project={projectMeta}
    breadcrumbs={[{ name: "Home", url: SITE_URL }, { name: "Quite Off", url: `${SITE_URL}/quite_off` }]}>

    <ProjectSemanticInfo
        title={projectMeta.name}
        year={projectMeta.year}
        medium={projectMeta.medium}
        artform={projectMeta.artform}
        location={projectMeta.location}
        description={projectMeta.description}
    />

    <div class="qo-viewport qo-viewport--desktop">
        <div class="qo_page" id="qo_page">
            <div class="qo_grid">
                <div class="qo_viewer">
                    <p class="qo_stock_above">Kodak Vision3 5203 / 5207 / 5219</p>
                    <div class="qo_stage" aria-live="polite">
                        <div class="qo_frame">
                            <img
                                class="qo_image"
                                id="qo-image"
                                src={imageData[0].src}
                                srcset={imageData[0].srcset}
                                sizes={imageData[0].sizes}
                                width={imageData[0].width}
                                height={imageData[0].height}
                                alt={imageData[0].alt}
                                data-index="0"
                                loading="eager"
                                fetchpriority="high"
                                decoding="async"
                            />
                        </div>
                    </div>
                    <div class="qo_controls">
                        <button type="button" class="qo_btn qo_prev" aria-label="Previous image">←</button>
                        <span class="qo_hint">Use ←/↑ for previous, →/↓ for next</span>
                        <button type="button" class="qo_btn qo_next" aria-label="Next image">→</button>
                    </div>
                </div>
                <aside class="qo_panel">
                    <div class="qo_text">
                        <div class="qo_narrative">
                            <p>
                                Quite Off unfolds as a film that never reaches completion. Every image holds a suspended <span class="semantic" data-key="beginning">beginning</span>, where the <span class="semantic" data-key="gaze">gaze</span> lingers before meaning forms. The <span class="semantic" data-key="eyes">eyes</span> remain within the act of watching, tracing a fragile <span class="semantic" data-key="presence">presence</span>.
                            </p>
                            <p>
                                We wrote a script and storyboards; filming became a path toward separation. A quiet <span class="semantic" data-key="distance">distance</span> — where <span class="semantic" data-key="touch">touch</span> becomes uncertain and <span class="semantic" data-key="silence">silence</span> carries weight. The <span class="semantic" data-key="mother">mother</span> as proximity without merging, a fragile <span class="semantic" data-key="closeness">closeness</span> shaped by restraint.
                            </p>
                            <p>
                                <span class="semantic" data-key="red">Red</span> insists; green persists. It enters like <span class="semantic" data-key="gravity">gravity</span>, <span class="semantic" data-key="bloom">blooms</span> without apology. Movement <span class="semantic" data-key="fracture">fractures</span> continuity — <span class="semantic" data-key="motion">motion</span>, <span class="semantic" data-key="crossing">crossings</span>, <span class="semantic" data-key="departure">departure</span>. What remains is not <span class="semantic" data-key="absence">absence</span> but an <span class="semantic" data-key="afterimage">afterimage</span>; <span class="semantic" data-key="memory">memory</span> circulates beneath every frame.
                            </p>
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </div>

    <script is:inline>
        if (window.innerWidth <= 768) window.location.replace("/quite_off_mobile");
    </script>

    <style is:global>
        /* 强制覆盖 base_layout，仅桌面端 */
        @media (min-width: 769px) {
            main.content:has(.qo_page) {
                padding: 0 !important;
                max-width: none !important;
                margin: 0 !important;
                width: 100% !important;
                height: 100dvh !important;
                overflow: hidden !important;
            }
            main.content:has(.qo_page) > * {
                max-width: none !important;
                width: 100% !important;
            }
        }
    </style>

    <style>
        /* 桌面端样式：仅 769px+ 应用，避免影响移动端 */
        @media (min-width: 769px) {
        .qo_page { --qo-green: #2f6f52; --qo-sidew: 320px; --qo-top: 44px; }
        .qo_page { height: 100%; min-height: 100dvh; overflow: hidden; display: flex; flex-direction: column; }
        .qo_grid { flex: 1; min-height: 0; display: grid; grid-template-columns: repeat(4, minmax(0, calc((100% - 24px - 320px) / 4))) 24px 160px 160px; gap: 0; }
        .qo_viewer { grid-column: 1 / 5; width: 100%; min-width: 0; height: 100%; min-height: 0; display: flex; flex-direction: column; padding: var(--qo-top) 28px 10px; box-sizing: border-box; justify-content: flex-start; align-items: stretch; }
        .qo_stock_above { margin: 0 0 8px; font-size: var(--text-small, 14px); color: var(--muted, #555); flex-shrink: 0; text-align: center; }
        .qo_stage { flex: 1; min-height: 0; min-width: 0; display: flex; align-items: center; justify-content: center; }
        .qo_frame { width: 100%; height: 100%; min-height: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; }
        .qo_image { --qo-image-nudge: 15px; max-width: 90%; max-height: 90%; width: auto; height: auto; object-fit: contain; display: block; margin-left: var(--qo-image-nudge, 0); transition: opacity 240ms ease-in-out; }
        .qo_page { max-width: none !important; }
        .qo_grid { display: grid !important; grid-template-columns: repeat(4, minmax(0, 1fr)) 24px 160px 160px !important; width: 100% !important; max-width: none !important; }
        .qo_viewer { grid-column: 1 / 5 !important; width: 100% !important; max-width: none !important; min-width: 0 !important; display: flex !important; align-items: stretch !important; }
        .qo_stage { min-width: 0 !important; display: flex !important; align-items: center !important; justify-content: center !important; }
        .qo_frame { width: 100% !important; max-width: 100% !important; display: flex !important; align-items: center !important; justify-content: center !important; }
        .qo_panel { grid-column: 6 / 8 !important; width: 100% !important; max-width: none !important; min-width: 0 !important; display: flex !important; align-items: stretch !important; }
        .qo_text, .qo_narrative { width: 100% !important; max-width: 100% !important; min-width: 0 !important; }
        .qo_image.is-fading-out { opacity: 0; transition: opacity 180ms ease-in-out; }
        .qo_image.is-fading-in { opacity: 1; transition: opacity 240ms ease-in-out; }
        .qo_controls { display: flex; align-items: center; justify-content: center; gap: 22px; padding: 12px 0 30px; flex-shrink: 0; width: 100%; }
        .qo_btn { background: none; border: none; padding: 8px 12px; font-size: 1rem; color: var(--muted, #6a6a6a); cursor: pointer; transition: opacity 180ms ease, color 180ms ease; }
        .qo_btn:hover { opacity: 0.85; color: var(--text, #111); }
        .qo_btn:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
        .qo_hint { font-size: var(--text-small, 14px); color: var(--muted, #555); letter-spacing: 0.02em; text-align: center; }
        .qo_panel { grid-column: 6 / 8; width: 100%; min-width: 0; margin-left: -10px; padding: calc(var(--qo-top) + 10px) 18px 18px; overflow: hidden; border-left: 1px solid var(--line, #ececec); display: flex; flex-direction: column; align-items: stretch; min-height: 0; box-sizing: border-box; }
        .qo_text { margin-top: 60px; width: 100%; min-width: 0; flex: 1; overflow: hidden; min-height: 0; padding-left: 20px; padding-right: 20px; box-sizing: border-box; }
        .qo_narrative { width: 100%; max-width: 100%; font-size: var(--text-body, 16px); line-height: 1.72; color: rgba(0, 0, 0, 0.84); overflow: hidden; margin: 0; padding: 0; min-height: 0; box-sizing: border-box; }
        .qo_narrative p { margin: 0 0 0.9em; }
        .qo_narrative p:last-child { margin-bottom: 0; }
        .semantic { transition: color 160ms ease, font-weight 160ms ease; }
        .semantic.semantic-active { color: var(--qo-green); font-weight: 520; }
        /* 桌面端内小屏（768-900px）：grid 塌陷为单列 */
        @media (max-width: 900px) {
            :global(main.content:has(.qo_page)) { height: auto; overflow: visible; }
            .qo_grid { grid-template-columns: 1fr; grid-template-rows: auto auto; }
            .qo_viewer { grid-column: 1; }
            .qo_panel { grid-column: 1; border-left: none; border-top: 1px solid var(--line, #ececec); padding-top: 18px; }
        }
        }
    </style>

    <script type="application/json" id="qo-image-data" set:html={JSON.stringify(qoRuntimeData)} />
    <script>
        // @ts-nocheck
        (function () {
            if (window.innerWidth <= 768) return;
            const pageEl = document.getElementById("qo_page");
            const imageEl = document.getElementById("qo-image");
            const prevBtn = document.querySelector(".qo_prev");
            const nextBtn = document.querySelector(".qo_next");
            const semanticSpans = document.querySelectorAll(".semantic");
            const dataEl = document.getElementById("qo-image-data");
            let runtimeData = { images: [], semanticMap: {} };
            try {
                runtimeData = JSON.parse(dataEl?.textContent || "{}");
            } catch (_) {}
            const imageList = runtimeData.images || [];
            const semanticMap = runtimeData.semanticMap || {};
            const total = imageList.length;
            let index = Number(imageEl?.dataset?.index || "0") || 0;
            let isTransitioning = false;
            function getKeys(i) { return semanticMap[i] ?? []; }
            function updateSemantic() {
                semanticSpans.forEach(s => s.classList.remove("semantic-active"));
                getKeys(index).forEach(key => { semanticSpans.forEach(s => { if (s.getAttribute("data-key") === key) s.classList.add("semantic-active"); }); });
            }
            function applyImage(item, nextIndex) {
                if (!imageEl || !item) return;
                if (item.srcset) imageEl.srcset = item.srcset;
                if (item.sizes) imageEl.sizes = item.sizes;
                imageEl.src = item.src;
                imageEl.alt = item.alt || "";
                imageEl.dataset.index = String(nextIndex);
                if (item.width) imageEl.setAttribute("width", String(item.width));
                if (item.height) imageEl.setAttribute("height", String(item.height));
            }
            function preloadImage(item) {
                if (!item) return Promise.resolve();
                return new Promise((resolve) => {
                    const img = new Image();
                    img.decoding = "async";
                    if (item.srcset) img.srcset = item.srcset;
                    if (item.sizes) img.sizes = item.sizes;
                    img.src = item.src;
                    if (img.decode) img.decode().then(resolve, resolve);
                    else {
                        img.onload = resolve;
                        img.onerror = resolve;
                    }
                });
            }
            function delay(ms) {
                return new Promise((resolve) => setTimeout(resolve, ms));
            }
            function preloadAdjacent() {
                if (!total) return;
                const idle = window.requestIdleCallback || ((cb) => setTimeout(cb, 300));
                idle(() => {
                    preloadImage(imageList[(index + 1) % total]);
                    preloadImage(imageList[(index - 1 + total) % total]);
                });
            }
            function fadeSwap(next) {
                if (!imageEl || isTransitioning || !total) return;
                const domIndex = Number(imageEl.dataset.index);
                if (Number.isFinite(domIndex)) index = domIndex;
                next = (next + total) % total;
                if (next === index) return;
                isTransitioning = true;
                imageEl.classList.add("is-fading-out");
                Promise.all([preloadImage(imageList[next]), delay(140)]).then(() => {
                    index = next;
                    applyImage(imageList[index], index);
                    updateSemantic();
                    requestAnimationFrame(() => {
                        imageEl.classList.remove("is-fading-out");
                        imageEl.classList.add("is-fading-in");
                        setTimeout(() => {
                            imageEl.classList.remove("is-fading-in");
                            isTransitioning = false;
                            preloadAdjacent();
                        }, 220);
                    });
                });
            }
            if (prevBtn) prevBtn.addEventListener("click", () => fadeSwap(index <= 0 ? total - 1 : index - 1));
            if (nextBtn) nextBtn.addEventListener("click", () => fadeSwap(index >= total - 1 ? 0 : index + 1));
            window.addEventListener("keydown", e => {
                if (e.repeat) return;
                if (e.key === "ArrowLeft" || e.key === "ArrowUp") { e.preventDefault(); fadeSwap(index <= 0 ? total - 1 : index - 1); }
                else if (e.key === "ArrowRight" || e.key === "ArrowDown") { e.preventDefault(); fadeSwap(index >= total - 1 ? 0 : index + 1); }
            });
            function measure() { if (pageEl) { const w = document.querySelector("aside.sidebar")?.getBoundingClientRect().width ?? 0; pageEl.style.setProperty("--qo-sidew", w > 0 ? w + "px" : "320px"); } }
            window.addEventListener("resize", measure);
            measure();
            applyImage(imageList[index], index);
            updateSemantic();
            preloadAdjacent();
        })();
    </script>
</BaseLayout>
