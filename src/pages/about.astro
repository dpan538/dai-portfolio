---
import BaseLayout from "../layouts/base_layout.astro";

// 展览与奖项的官方链接（用于页面中的可验证出处）
const exhibitionLinks: Record<string, string> = {
    "Colour, The Glasgow Gallery of Photography, Glasgow, UK": "https://www.glasgowgalleryofphotography.com/",
    "Cityscapes, Blank Wall Gallery, Athens, Greece": "https://www.blankwallgallery.com/",
    "POLAROID: The Instant Image, Praxis Gallery, Minneapolis, MN, USA": "https://www.praxisphotocenter.org/",
    "POP - Popular Participation, Getxophoto Festival, Algorta, Spain; May 28-June 21; image display and printed publication": "",
    "City Lights, Virtual Photography Exhibition, Carlotta Gallery": "",
    "Horizons, Allora Gallery, London, UK": "https://alloragallery.com/horizons",
};
const awardLinks: Record<string, string> = {
    "Honorable Mention, Conceptual Category, MonoVisions Photography Awards (10th Edition) - Fading Into Noise": "https://monovisionsawards.com/winners-gallery/monovisions-awards-2026/single/conceptual/honorable-mentions",
    "Highly Commended, Homiens Art Prize, Winter 2026": "https://homiens.com/prize-winners/",
    "Black & White Art Competition, Merit Award, Art Room Gallery": "https://www.artroomgalleryonline.com/",
    "Winter Open Theme, Group Exhibition (Finalist), Art-Collide": "https://art-collide.com/open-theme-winter-2024-2025",
    "Honorable Mention in Culture (Professional), Chromatic Awards": "https://chromaticawards.com/",
    "2nd Bold Colors, Online Juried Exhibition (Finalist), Blue Koi Gallery": "https://koisartistaward.com/2nd-bold-colors-art-exhibition/",
};

---

<BaseLayout
    title="About Dai Pan (潘岱) — Visual Artist & Designer"
    description="About Dai Pan / Pan Dai (潘岱), a visual artist, designer, photographer, printmaker, and writer based in Brisbane. Official portfolio at daipan.art; writing collection at daipan.ink."
    canonical="https://daipan.art/about"
    active="about"
    keywords={["Dai Pan biography", "Pan Dai artist", "潘岱", "Brisbane artist", "Chinese visual artist", "School of Visual Arts Dai Pan", "photographer printmaker writer"]}
    breadcrumbs={[{ name: "Home", url: "https://daipan.art" }, { name: "About", url: "https://daipan.art/about" }]}>
    <section class="block about_intro">
        <figure class="about_photo" aria-label="Portrait of Dai Pan">
            <img
                src="/projects/about/about.jpg"
                alt="Portrait of Dai Pan"
                loading="lazy"
            />
        </figure>

        <div class="about_text">
            <div class="about_text--desktop">
                <p>
                    Dai Pan (潘岱) is a visual artist, designer, photographer,
                    printmaker, and writer based in Brisbane. His practice examines
                    how images shape spatial perception through framing, sequence,
                    repetition, and material process. He approaches photographs,
                    prints, books, architecture-related studies, and designed forms as
                    systems for looking and reading.
                </p>
                <p>
                    His projects translate everyday environments into sequences where
                    clarity and distortion coexist. Rather than treating images as direct
                    documents, he works with them as constructed fields shaped by colour,
                    surface, time, and compositional constraint. Across still images,
                    print-based works, and writing, Dai Pan develops slow visual systems
                    that invite open interpretation.
                </p>
            </div>
            <div class="about_text--mobile">
                <p>
                    Dai Pan (潘岱) is a visual artist, designer, photographer,
                    printmaker, and writer based in Brisbane. His practice examines
                    how images shape spatial perception through framing, sequence,
                    repetition, and material process. He treats images as constructed
                    fields for perception, memory, and slow looking.
                </p>
            </div>
        </div>
    </section>

    <section class="block">
        <h2>Education</h2>
        <ul class="cv">
            <li>
                <span class="cv_key">Current</span>
                <span class="cv_val"
                    >University of Queensland, Brisbane, Australia — Master of
                    Information Technology (in progress)</span
                >
            </li>
            <li>
                <span class="cv_key">BFA</span>
                <span class="cv_val"
                    >School of Visual Arts (SVA), New York, USA — Bachelor of
                    Fine Arts in Design (2021-2025)</span
                >
            </li>
        </ul>
    </section>

    <section class="block">
        <h2>Group Exhibitions</h2>
        <ul class="cv">
            {
                [
                    ["2026", "Colour, The Glasgow Gallery of Photography, Glasgow, UK"],
                    ["2026", "Cityscapes, Blank Wall Gallery, Athens, Greece"],
                    ["2026", "POLAROID: The Instant Image, Praxis Gallery, Minneapolis, MN, USA"],
                    ["2026", "POP - Popular Participation, Getxophoto Festival, Algorta, Spain; May 28-June 21; image display and printed publication"],
                    ["2026", "City Lights, Virtual Photography Exhibition, Carlotta Gallery"],
                    ["2026", "Horizons, Allora Gallery, London, UK"],
                ].map(([year, text]) => {
                    const href = exhibitionLinks[text];
                    return (
                        <li>
                            <span class="cv_key">{year}</span>
                            <span class="cv_val">
                                {href ? <a href={href} target="_blank" rel="noopener noreferrer">{text}</a> : text}
                            </span>
                        </li>
                    );
                })
            }
        </ul>
    </section>

    <section class="block">
        <h2>Awards &amp; Recognition</h2>
        <ul class="cv">
            {
                [
                    ["2026", "Honorable Mention, Conceptual Category, MonoVisions Photography Awards (10th Edition) - Fading Into Noise"],
                    ["2026", "Highly Commended, Homiens Art Prize, Winter 2026"],
                    ["2026", "Black & White Art Competition, Merit Award, Art Room Gallery"],
                    ["2025", "Winter Open Theme, Group Exhibition (Finalist), Art-Collide"],
                    ["2025", "Honorable Mention in Culture (Professional), Chromatic Awards"],
                    ["2024", "2nd Bold Colors, Online Juried Exhibition (Finalist), Blue Koi Gallery"],
                ].map(([year, text]) => {
                    const href = awardLinks[text];
                    return (
                        <li>
                            <span class="cv_key">{year}</span>
                            <span class="cv_val">
                                {href ? <a href={href} target="_blank" rel="noopener noreferrer">{text}</a> : text}
                            </span>
                        </li>
                    );
                })
            }
        </ul>
    </section>

    <section class="block about_writing_block">
        <h2>Writing</h2>
        <p class="about_writing">
            Selected writing and literary work are collected at
            <a href="https://www.daipan.ink/" target="_blank" rel="me noopener noreferrer">daipan.ink</a>,
            Dai Pan's writing collection.
        </p>
    </section>

    <section class="block about_contact_block">
        <h2>Contact</h2>
        <ul class="about_contact_list">
            <li><a href="mailto:dpan53853@gmail.com">dpan53853@gmail.com</a></li>
            <li>
                <a href="https://www.instagram.com/jumpingchick666" target="_blank" rel="noopener noreferrer">
                    <span class="contact_ig--desktop">Instagram</span>
                    <span class="contact_ig--mobile">Instagram @jumpingchick666</span>
                </a>
            </li>
        </ul>
    </section>

    <section class="block">
        <p class="about_disclaimer" aria-label="Disambiguation">Dai Pan (潘岱) is a visual artist, designer, photographer, printmaker, and writer. This site is not affiliated with DAIPAN Butoh Collective (Seattle).</p>
    </section>

    <style>
        .block {
            margin-top: 6px;
        }

        .about_intro {
            display: grid;
            grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
            gap: 32px;
            align-items: start;
        }

        .about_photo {
            margin: 0;
            border: 1px solid var(--line);
            background: #f8f8f8;
        }

        .about_photo img {
            display: block;
            width: 100%;
            height: auto;
        }

        .about_text {
            font-size: var(--text-body, 16px);
            line-height: 1.7;
            align-self: end; /* 与照片底部对齐 */
        }

        .cv {
            list-style: none;
            padding: 0;
            margin: 0;
            display: grid;
            gap: 10px;
        }

        .cv li {
            display: grid;
            grid-template-columns: 92px 1fr;
            gap: 18px;
            align-items: start;
        }

        .cv_key {
            font-size: var(--text-small, 14px);
            color: var(--muted);
            white-space: nowrap;
            letter-spacing: 0.02em;
        }

        .cv_val {
            font-size: var(--text-body, 16px);
        }

        .cv_val a {
            color: var(--text);
            text-decoration: none;
        }

        .cv_val a:hover {
            color: var(--muted);
            text-decoration: underline;
            text-underline-offset: 3px;
        }

        .about_contact_block {
            margin-top: 28px;
        }

        .about_writing_block {
            margin-top: 28px;
        }

        .about_writing {
            max-width: 70ch;
            margin: 0;
            font-size: var(--text-body, 16px);
            line-height: 1.7;
            color: rgba(0, 0, 0, 0.78);
        }

        .about_writing a {
            color: var(--text);
            text-decoration: underline;
            text-underline-offset: 3px;
        }

        .about_contact_list {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .about_contact_list a {
            font-size: var(--text-body, 16px);
            color: var(--text);
            text-decoration: none;
        }

        .about_contact_list a:hover {
            text-decoration: underline;
            text-underline-offset: 3px;
            color: var(--muted);
        }

        .about_disclaimer {
            margin: 24px 0 0;
            font-size: var(--text-meta, 13.5px);
            color: var(--muted);
            line-height: 1.5;
        }

        @media (max-width: 800px) {
            .about_intro {
                grid-template-columns: 1fr;
                row-gap: 20px;
            }
        }

        /* 移动端：隐藏滚动条 */
        @media (max-width: 768px) {
            :global(main.content:has(.about_intro)) {
                padding-top: 114px;
            }

            :global(html:has(.about_intro))::-webkit-scrollbar,
            :global(body:has(.about_intro))::-webkit-scrollbar {
                display: none;
                width: 0;
            }
            :global(html:has(.about_intro)),
            :global(body:has(.about_intro)) {
                scrollbar-width: none;
                -ms-overflow-style: none;
            }

            .block {
                margin-top: 0;
            }

            .block + .block {
                margin-top: 18px;
            }

            .about_intro {
                row-gap: 14px;
            }

            .about_photo {
                width: min(58vw, 190px);
                margin-inline: auto;
            }

            .about_text {
                font-size: 15.5px;
                line-height: 1.66;
            }

            .cv {
                gap: 8px;
            }

            .cv li {
                grid-template-columns: 64px 1fr;
                gap: 12px;
            }

            .cv_key {
                font-size: 13.5px;
            }

            .cv_val,
            .about_writing,
            .about_contact_list a {
                font-size: 15.5px;
            }

            .about_writing_block,
            .about_contact_block {
                margin-top: 18px;
            }

            .about_disclaimer {
                margin-top: 18px;
            }
        }

        /* 移动端 only：精简介绍、Instagram @ */
        @media (min-width: 769px) {
            .about_text--mobile { display: none; }
            .contact_ig--mobile { display: none; }
        }
        @media (max-width: 768px) {
            .about_text--desktop { display: none; }
            .contact_ig--desktop { display: none; }
        }

    </style>
</BaseLayout>
