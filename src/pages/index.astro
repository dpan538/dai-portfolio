---
import BaseLayout from "../layouts/base_layout.astro";
---

<BaseLayout
    title="Dai Pan"
    description="Dai Pan (潘岱) — fine artist and designer working across photography, printmaking, writing, visual art, and design research. Portfolio includes Quite Off, Masks, Monolith for Light, The Threes, and Reframed Still."
    active=""
    homePage={true}
>
    <div class="home_content">
        <p class="home_para">
            I am Dai Pan, a fine artist and designer working through
            photography, printmaking, writing, and design research. My work
            treats images as structures of perception, memory, material, and
            attention. This site gathers selected visual art projects,
            photographs, prints, books, and research-led works made so far.
        </p>
        <p class="home_hint" id="home_hint" aria-live="polite">
            <span class="home_hint-desktop">Read or click the projects in the left sidebar to view.</span>
            <span class="home_hint-mobile">Tap the menu to view works.</span>
        </p>
        <nav class="home_social" aria-label="Dai Pan social links">
            <a class="home_social_link" href="mailto:dpan53853@gmail.com" aria-label="Email Dai Pan">
                <svg
                    viewBox="0 0 24 24"
                    width="28"
                    height="28"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    aria-hidden="true">
                    <path d="M4 6h16v12H4z"></path>
                    <path d="M4 7l8 6 8-6"></path>
                </svg>
            </a>
            <a
                class="home_social_link"
                href="https://www.instagram.com/jumpingchick666"
                target="_blank"
                rel="me noopener noreferrer"
                aria-label="Dai Pan on Instagram">
                <svg
                    viewBox="0 0 24 24"
                    width="32"
                    height="32"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    aria-hidden="true">
                    <rect x="5.5" y="5.5" width="13" height="13" rx="4"></rect>
                    <circle cx="12" cy="12" r="3.2"></circle>
                    <circle cx="15.9" cy="8.1" r="0.65" fill="currentColor" stroke="none"></circle>
                </svg>
            </a>
        </nav>
    </div>

    <footer class="site_footer">
        <p class="copyright">© {new Date().getFullYear()} Dai Pan.</p>
    </footer>
</BaseLayout>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const hint = document.getElementById("home_hint");
        if (hint) setTimeout(() => hint.classList.add("is-visible"), 3600);
    });
</script>

<style>
    /* Desktop only (>768px): .content--home layout */
    @media (min-width: 769px) {
        :global(.content--home) .home_content {
            flex: 1;
            min-height: 0;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            max-width: 720px;
            padding-top: clamp(140px, 14vw, 200px);
            padding-inline: clamp(32px, 5vw, 64px);
            padding-bottom: clamp(32px, 5vw, 64px);
            box-sizing: border-box;
        }

        :global(.content--home) .site_footer {
            display: none;
        }
    }

    .home_para {
        margin: 0;
        font-family: var(--display);
        font-size: clamp(14.5px, 1.8vw, 23.5px);
        font-weight: 400;
        line-height: 1.55;
        letter-spacing: 0.01em;
        color: var(--text, #111);
        overflow: visible;
    }

    .home_hint {
        margin: 0;
        margin-top: 1.5rem;
        font-family: var(--body, system-ui, sans-serif);
        font-size: 16px;
        color: var(--muted, #6a6a6a);
        letter-spacing: 0.02em;
        opacity: 0;
        transition: opacity 0.4s ease;
    }

    .home_social {
        display: none;
    }

    .home_hint.is-visible {
        opacity: 1;
    }

    @media (min-width: 769px) {
        .home_hint-mobile {
            display: none;
        }

        .home_hint-desktop {
            display: inline;
        }
    }

    /* Mobile (<=768px): mobile_main layout - MUST override desktop */
    @media (max-width: 768px) {
        :global(.content--home.mobile_main) {
            padding-top: 0 !important;
            padding-bottom: 0 !important;
            min-height: 100svh;
        }

        :global(.mobile_main) {
            position: relative;
            display: block !important;
            overflow: hidden;
            min-height: 100svh;
        }

        :global(.mobile_main) .home_content {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            max-width: min(100%, 19.5ch) !important;
            width: min(100%, 19.5ch);
            min-width: 0;
            padding: 0 !important;
        }

        :global(.mobile_main) .home_para {
            transform: translateY(-85px);
        }

        :global(.mobile_main) .home_hint {
            font-size: 14px;
            margin-top: -71px;
        }

        :global(.mobile_main) .home_hint.is-visible {
            opacity: 0.55;
        }

        :global(.mobile_main) .home_hint-mobile {
            display: inline;
        }

        :global(.mobile_main) .home_hint-desktop {
            display: none;
        }

        :global(.mobile_main) .site_footer {
            position: absolute;
            left: 0;
            right: 0;
            bottom: max(26px, env(safe-area-inset-bottom, 0px));
            display: block !important;
            margin: 0;
            text-align: center;
        }

        .home_social {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 16px;
            margin: 37px 0 0;
        }

        .home_social_link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            color: var(--text, #111);
            opacity: 0.46;
            transition: opacity 180ms ease, transform 180ms ease;
            -webkit-tap-highlight-color: transparent;
        }

        .home_social_link:hover,
        .home_social_link:focus-visible {
            opacity: 0.82;
            text-decoration: none;
        }

        .home_social_link:active {
            transform: translateY(1px);
        }

        .home_social_link svg {
            width: 28px;
            height: 28px;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .copyright {
            margin: 0;
            font-size: 11px;
            color: var(--text, #111);
            opacity: 0.5;
            padding-bottom: 26px;
        }
    }

</style>
