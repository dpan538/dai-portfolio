---
import imageDimensions from "../data/image-dimensions.json";

const SITE_URL = "https://daipan.art";

const {
    title = "Dai Pan (潘岱) — Artist, Designer & Portfolio",
    description = "Official portfolio of Dai Pan / Pan Dai (潘岱), a visual artist, designer, photographer, printmaker, and writer based in Brisbane.",
    zhDescription = "Dai Pan / Pan Dai（潘岱）的个人作品集网站，展示视觉艺术、概念设计、摄影、建筑、版画、图像制作与写作项目。",
    canonical = SITE_URL,
    active = "", // "works" | "about" | "contact"
    homePage = false,
    ogImage = undefined as string | undefined,
    ogImageAlt = undefined as string | undefined,
    ogType = "website" as "website" | "article",
    breadcrumbs = undefined as { name: string; url: string }[] | undefined,
    keywords = [] as string[],
    project = undefined as {
            name?: string;
            schemaType?: string | string[];
            description?: string;
            year?: string;
            dateCreated?: string;
            medium?: string;
            artform?: string;
            location?: string | string[];
            keywords?: string[];
            images?: string[];
            imageAlt?: string;
        }
        | undefined,
} = Astro.props;

const seoTitle = title.includes("Dai Pan") ? title : `${title} — Dai Pan`;
const toAbsoluteUrl = (value: string) => value.startsWith("http") ? value : `${SITE_URL}${value}`;
const toPlaceSchema = (location: string | string[]) => Array.isArray(location)
    ? location.map((name) => ({ "@type": "Place", name }))
    : { "@type": "Place", name: location };
// 默认使用代表作品图，便于搜索引擎、社交平台和 AI 工具展示
const defaultOgImage = "/projects/quite_off/quite_01.jpg";
const resolvedOgImage = ogImage ?? defaultOgImage;
const absoluteOgImage = resolvedOgImage ? toAbsoluteUrl(resolvedOgImage) : undefined;
const localOgImagePath = resolvedOgImage?.startsWith(SITE_URL)
    ? resolvedOgImage.slice(SITE_URL.length)
    : resolvedOgImage?.startsWith("/")
        ? resolvedOgImage
        : undefined;
const ogImageMeta = localOgImagePath ? imageDimensions[localOgImagePath as keyof typeof imageDimensions] : undefined;
const resolvedOgImageAlt = ogImageAlt ?? `Social preview image for ${seoTitle}`;
const resolvedOgImageType = resolvedOgImage?.toLowerCase().endsWith(".png")
    ? "image/png"
    : resolvedOgImage
        ? "image/jpeg"
        : undefined;
const baseKeywords = [
    "Dai Pan",
    "Pan Dai",
    "潘岱",
    "daipan",
    "daipan.art",
    "daipan.ink",
    "Three Worlds Dai Pan",
    "visual artist",
    "fine artist",
    "artist portfolio",
    "designer",
    "Chinese artist",
    "Brisbane artist",
    "photographer",
    "printmaker",
    "writer",
    "conceptual design",
    "architecture",
    "design research",
    "visual art",
    "image-making",
    "fine art",
    "艺术家",
    "设计师",
    "纯艺术",
    "视觉艺术",
    "摄影师",
    "版画",
    "写作",
    "设计研究",
    "portfolio",
    "photography",
    "writing collection",
    "Monolith for Light",
    "Quite Off",
    "The Threes",
    "Reframed Still",
    "Closing Time",
    "Masks",
];
const allKeywords = Array.from(new Set([...baseKeywords, ...keywords, ...(project?.keywords ?? [])]));

const personSchema = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Dai Pan",
    alternateName: [
        "Pan Dai",
        "潘岱",
        "daipan",
        "pan dai",
        "dai pan",
    ],
    url: SITE_URL,
    jobTitle: "Visual Artist, Designer, Photographer, Printmaker, and Writer",
    description: "Official portfolio of Dai Pan / Pan Dai (潘岱), a visual artist, designer, photographer, printmaker, and writer based in Brisbane.",
    knowsAbout: [
        "fine art",
        "visual art",
        "conceptual design",
        "architecture",
        "photography",
        "printmaking",
        "design research",
        "image-making",
        "writing",
        "纯艺术",
        "视觉艺术",
        "概念设计",
        "建筑",
        "摄影",
        "版画",
        "设计研究",
        "图像制作",
        "写作",
    ],
    sameAs: [
        "https://www.instagram.com/jumpingchick666",
        "https://sva.design/students/dai-pan",
        "https://www.linkedin.com/in/daipanportfolio/",
        "https://www.daipan.ink/",
        "https://www.instagram.com/p/DT2UEHQCJiD/",
    ],
    subjectOf: [
        {
            "@type": "CreativeWorkSeries",
            name: "Three Worlds — Dai Pan",
            url: "https://www.daipan.ink/",
            genre: ["writing", "poetry", "literary writing"],
            author: { "@type": "Person", name: "Dai Pan", url: SITE_URL },
        },
    ],
    nationality: { "@type": "Country", "name": "China" },
    homeLocation: { "@type": "Place", "name": "Brisbane, Australia" },
    alumniOf: { "@type": "CollegeOrUniversity", "name": "School of Visual Arts", "url": "https://sva.edu", "address": { "@type": "PostalAddress", "addressLocality": "New York", "addressCountry": "US" } },
    image: `${SITE_URL}/projects/about/about.jpg`,
};

const websiteSchema = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Dai Pan (潘岱) — Artist, Designer & Portfolio",
    alternateName: ["潘岱", "Pan Dai", "daipan.art", "Dai Pan portfolio"],
    url: SITE_URL,
    description: "Official portfolio of Dai Pan / Pan Dai (潘岱), a visual artist, designer, photographer, printmaker, and writer based in Brisbane. Not affiliated with DAIPAN Butoh Collective.",
    image: absoluteOgImage || `${SITE_URL}/projects/quite_off/quite_01.jpg`,
    author: { "@type": "Person", "name": "Dai Pan", "url": SITE_URL },
    inLanguage: ["en", "zh-Hans"],
    relatedLink: ["https://www.daipan.ink/"],
};

const profilePageSchema = homePage
    ? {
        "@context": "https://schema.org",
        "@type": "ProfilePage",
        name: "Dai Pan (潘岱) — Artist, Designer & Portfolio",
        url: SITE_URL,
        description,
        about: personSchema,
        primaryImageOfPage: { "@type": "ImageObject", url: absoluteOgImage || `${SITE_URL}/projects/quite_off/quite_01.jpg` },
        inLanguage: ["en", "zh-Hans"],
    }
    : null;

const breadcrumbSchema = breadcrumbs?.length
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: breadcrumbs.map((item: { name: string; url: string }, i: number) => ({
            "@type": "ListItem",
            position: i + 1,
            name: item.name,
            item: item.url,
        })),
    }
    : null;

const nav = [
    { href: "/quite_off", label: "Quite Off", key: "quite_off"},
    { href: "/the_threes", label: "The Threes", key: "the_threes"},
    { href: "/gallery_design", label: "Monolith for Light", key: "gallery_design"},
    { href: "/reframed_still", label: "Reframed Still", key: "reframed_still"},
    { href: "/closing_time", label: "Closing Time", key: "closing_time"},
    { href: "/masks", label: "Masks", key: "masks"},
    { href: "/about", label: "About", key: "about" },
    { href: "/contact", label: "Contact", key: "contact" },
];

// Mobile overlay: 7 items, no Contact, extra spacing before About
const mobileNavItems = nav.filter((n) => n.key !== "contact");

const projectKeys = ["quite_off", "the_threes", "gallery_design", "reframed_still", "closing_time", "masks"];
const projectImages: Record<string, string> = {
    quite_off: "/projects/quite_off/quite_01.jpg",
    the_threes: "/projects/the_threes/threes_23.jpg",
    gallery_design: "/projects/monolith_for_light/gallery_01.jpg",
    reframed_still: "/projects/reframed_still/reframed01.jpg",
    closing_time: "/projects/closing_time/closing_time.jpg",
    masks: "/projects/masks/masks01.jpg",
};
const portfolioSchema = homePage
    ? {
        "@context": "https://schema.org",
        "@type": "ItemList",
        name: "Dai Pan — Works",
        description: "Image-based work across photography, printmaking, writing, visual art, and design research.",
        itemListElement: nav
            .filter((n) => projectKeys.includes(n.key))
            .map((n, i) => ({
                "@type": "ListItem",
                position: i + 1,
                item: {
                    "@type": "CreativeWork",
                    name: n.label,
                    url: `${SITE_URL}${n.href}`,
                    ...(projectImages[n.key] && { image: `${SITE_URL}${projectImages[n.key]}` }),
                    author: { "@type": "Person", name: "Dai Pan" },
                },
            })),
    }
    : null;

const creativeWorkSchema = ogType === "article"
    ? {
        "@context": "https://schema.org",
        "@type": project?.schemaType ?? "CreativeWork",
        name: project?.name ?? seoTitle,
        headline: seoTitle,
        description: project?.description ?? description,
        url: canonical,
        mainEntityOfPage: canonical,
        ...(project?.images?.length
            ? { image: project.images.map(toAbsoluteUrl), thumbnailUrl: toAbsoluteUrl(project.images[0]) }
            : absoluteOgImage && { image: absoluteOgImage, thumbnailUrl: absoluteOgImage }),
        ...(project?.imageAlt && { caption: project.imageAlt }),
        ...(project?.dateCreated && { dateCreated: project.dateCreated }),
        ...(project?.year && { temporalCoverage: project.year }),
        ...(project?.medium && { artMedium: project.medium, material: project.medium }),
        ...(project?.artform && { artform: project.artform, genre: project.artform }),
        ...(project?.location && { locationCreated: toPlaceSchema(project.location), contentLocation: toPlaceSchema(project.location) }),
        ...(project?.keywords?.length && {
            keywords: project.keywords.join(", "),
            about: project.keywords.map((name) => ({ "@type": "Thing", name })),
        }),
        creator: { "@type": "Person", name: "Dai Pan", alternateName: ["Pan Dai", "潘岱"], url: SITE_URL },
        author: { "@type": "Person", name: "Dai Pan", alternateName: ["Pan Dai", "潘岱"], url: SITE_URL },
        isPartOf: { "@type": "WebSite", name: "Dai Pan (潘岱) — Artist, Designer & Portfolio", url: SITE_URL },
        inLanguage: "en",
    }
    : null;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{seoTitle}</title>

        <meta name="description" content={description} />
        <meta name="dc.description" lang="zh-Hans" content={zhDescription} />
        <meta name="robots" content="index, follow" />
        <meta name="author" content="Dai Pan" />
        <meta name="keywords" content={allKeywords.join(", ")} />
        <link rel="canonical" href={canonical} />
        <link rel="me" href="https://www.daipan.ink/" />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="alternate icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta name="theme-color" content="#ffffff" />
        <!-- 百度/360 站长验证：在各自站长平台获取验证码后，取消注释并填入 content -->
        <!-- <meta name="baidu-site-verification" content="YOUR_BAIDU_CODE" /> -->
        <!-- <meta name="360-site-verification" content="YOUR_360_CODE" /> -->

        <!-- Open Graph -->
        <meta property="og:title" content={seoTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={canonical} />
        <meta property="og:site_name" content="Dai Pan" />
        <meta property="og:locale" content="en_US" />
        <meta property="og:locale:alternate" content="zh_CN" />
        {absoluteOgImage && (
            <>
                <meta property="og:image" content={absoluteOgImage} />
                <meta property="og:image:secure_url" content={absoluteOgImage} />
                {resolvedOgImageType && <meta property="og:image:type" content={resolvedOgImageType} />}
                {ogImageMeta && <meta property="og:image:width" content={String(ogImageMeta.width)} />}
                {ogImageMeta && <meta property="og:image:height" content={String(ogImageMeta.height)} />}
                <meta property="og:image:alt" content={resolvedOgImageAlt} />
            </>
        )}

        <!-- Twitter Card -->
        <meta name="twitter:card" content={absoluteOgImage ? "summary_large_image" : "summary"} />
        <meta name="twitter:title" content={seoTitle} />
        <meta name="twitter:description" content={description} />
        {absoluteOgImage && <meta name="twitter:image" content={absoluteOgImage} />}
        {absoluteOgImage && <meta name="twitter:image:alt" content={resolvedOgImageAlt} />}

        <!-- Preconnect for fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600&family=Coustard:wght@400;900&family=Oldenburg&display=swap"
            rel="stylesheet"
        />

        <!-- Structured Data: Person, WebSite, BreadcrumbList -->
        <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
        <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
        {profilePageSchema && <script type="application/ld+json" set:html={JSON.stringify(profilePageSchema)} />}
        {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
        {portfolioSchema && <script type="application/ld+json" set:html={JSON.stringify(portfolioSchema)} />}
        {creativeWorkSchema && <script type="application/ld+json" set:html={JSON.stringify(creativeWorkSchema)} />}

        <slot name="head" />
    </head>

    <body>
        <!-- Mobile header: fixed row with brand + menu button (<=768px only) -->
        <header class="mobile_header" id="mobile_header">
            <a href="/" class="mobile_brand" id="mobile_brand" aria-label="Dai Pan – Home">
                Dai Pan
            </a>
            <button
                type="button"
                class="mobile_menu_btn"
                id="mobile_menu_btn"
                aria-label="Open menu"
                aria-expanded="false"
                aria-controls="mobile_overlay">
                <span class="mobile_menu_icon mobile_menu_icon--hamburger" aria-hidden="true">☰</span>
                <span class="mobile_menu_icon mobile_menu_icon--close" aria-hidden="true">✕</span>
            </button>
        </header>

        <div class="shell">
            <aside class="sidebar">
                <div class="brand">
                    <a href="/" class="brand_name">Dai Pan</a>
                </div>

                <nav class="menu">
                    {
                        nav.map((item) => (
                            <a
                                class={`menu_link ${active === item.key ? "is_active" : ""} ${item.key === "about" ? "menu_link--after_projects" : ""}`}
                                href={item.href}
                                data-project={item.key}>
                                {item.label}
                            </a>
                        ))
                    }
                </nav>

                <!-- Social icons (keep minimal) -->
                <div class="social">
                    <a
                        class="icon_link"
                        href="mailto:dpan53853@gmail.com"
                        aria-label="Email (Work)">
                        <svg
                            viewBox="0 0 24 24"
                            width="28"
                            height="28"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.6">
                            <path d="M4 6h16v12H4z"></path>
                            <path d="M4 7l8 6 8-6"></path>
                        </svg>
                    </a>

                    <a
                        class="icon_link"
                        href="https://www.instagram.com/jumpingchick666"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Instagram">
                        <svg
                            viewBox="0 0 24 24"
                            width="32"
                            height="32"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.6">
                            <rect x="6" y="6" width="12" height="12" rx="3"
                            ></rect>
                            <path
                                d="M12 15.2a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4z"
                            ></path>
                            <path d="M16.2 7.8h.01"></path>
                        </svg>
                    </a>
                </div>
            </aside>

            <main class:list={["content", { "content--home": homePage }, { "mobile_main": homePage }]}>
                <slot />
            </main>
        </div>

        <!-- Mobile overlay: full-screen menu (<=768px) -->
        <div
            id="mobile_overlay"
            class="mobile_overlay"
            role="dialog"
            aria-modal="true"
            aria-label="Navigation menu"
            aria-hidden="true"
            data-open="false">
            <div class="mobile_overlay_backdrop" id="mobile_overlay_backdrop"></div>
            <nav class="mobile_overlay_menu" id="mobile_overlay_menu">
                {
                    mobileNavItems.map((item) => (
                            <a
                                class={`mobile_overlay_link ${active === item.key ? "is_active" : ""} ${item.key === "about" ? "mobile_overlay_link--before_about" : ""}`}
                                href={item.href}>
                                {item.label}
                            </a>
                    ))
                }
            </nav>
        </div>

        <style>
            :global(:root) {
                --body:
                    "Be Vietnam Pro", system-ui, -apple-system, Segoe UI,
                    Roboto, Helvetica, Arial;
                --heading:
                    "Coustard", ui-serif, Georgia, "Times New Roman", Times,
                    serif;
                --display: "Oldenburg", serif;

                --bg: #ffffff;
                --text: #111111;
                --muted: #555555;
                --line: #ececec;
                --max: 900px;
                --top_align: 64px;
                --mobile-padding-x: 26px;
                --text-body: 16px;
                --text-small: 14px;
                --text-meta: 13.5px;
                --app-vh: 100vh;
                --app-dvh: 100vh;
            }

            @supports (height: 100svh) {
                :global(:root) {
                    --app-vh: 100svh;
                }
            }

            @supports (height: 100dvh) {
                :global(:root) {
                    --app-dvh: 100dvh;
                }
            }

            :global(html) {
                -webkit-text-size-adjust: 100%;
                text-size-adjust: 100%;
            }

            :global(body) {
                margin: 0;
                background: var(--bg);
                color: var(--text);
                font-family: var(--body);
                line-height: 1.6;
                font-size: 18px;
                letter-spacing: 0.1px;
                -webkit-font-smoothing: antialiased;
                text-rendering: optimizeLegibility;
            }

            :global(a) {
                color: inherit;
                text-decoration: none;
            }

            /* subtle hover, barely visible */
            :global(a:hover) {
                text-decoration: underline;
                text-underline-offset: 3px;
            }

            :global(a:focus-visible),
            :global(button:focus-visible) {
                outline: 2px solid currentColor;
                outline-offset: 3px;
            }

            .shell {
                position: relative;
                z-index: 0;
                min-height: 100vh;
                min-height: var(--app-vh);
                display: grid;
                grid-template-columns: 280px 1fr;
            }

            .sidebar {
                padding: 48px 48px;
                border-right: 1px solid var(--line);
                position: sticky;
                top: 0;
                height: 100vh;
                box-sizing: border-box;
                display: flex;
                flex-direction: column;
                gap: 18px;
            }

            .brand_name {
                font-family: var(--display);
                font-weight: 400;
                letter-spacing: 0.06em;
                font-size: 34px;
            }

            .menu {
                display: grid;
                gap: 12px;
                margin-top: 10px;
            }

            .menu_link {
                font-size: 20px;
                color: var(--muted);
                width: fit-content;
                transition: color 0.44s cubic-bezier(0.25, 0.1, 0.25, 1), font-weight 0.4s cubic-bezier(0.25, 0.1, 0.25, 1);
            }

            .menu_link.is_active {
                color: var(--text);
                text-decoration: underline;
                text-underline-offset: 3px;
            }

            .menu_link--after_projects {
                margin-top: 1.5em;
            }

            .social {
                margin-top: auto;
                display: flex;
                gap: 12px;
                color: var(--muted);
            }

            .icon_link {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 36px;
                height: 36px;
                border-radius: 999px;
            }

            .icon_link svg {
                width: 32px;
                height: 32px;
            }

            .icon_link:hover {
                text-decoration: none;
                outline: 1px solid var(--line);
                color: var(--text);
            }

            .content {
                padding: 64px 64px 72px;
                box-sizing: border-box;
            }

            .content > :global(*) {
                max-width: var(--max);
            }

            :global(h1) {
                font-family: var(--display);
                margin: 0 0 16px;
                font-size: 32px;
                font-weight: 600;
                letter-spacing: 0.2px;
            }

            :global(h2) {
                font-family: var(--heading);
                margin: 30px 0 10px;
                font-size: 16px;
                font-weight: 600;
                letter-spacing: 0.05em;
                text-transform: uppercase;
                color: var(--text);
            }

            :global(p) {
                margin: 0 0 14px;
            }

            @media (max-width: 820px) {
                .shell {
                    grid-template-columns: 1fr;
                }
                .sidebar {
                    position: relative;
                    height: auto;
                    border-right: none;
                    border-bottom: 1px solid var(--line);
                }
            }

            .shell {
                display: grid;
                grid-template-columns: 320px 1fr;
                min-height: 100vh;
                min-height: var(--app-vh);
            }

            .main {
                min-width: 0; /* 很重要：防止图片/长文本把布局撑爆 */
            }

            .content {
                /* 关键：在右侧 1fr 区域里居中 */
                max-width: 980px; /* 你想要更窄就 900/920 */
                margin-inline: auto;
                padding-inline: clamp(28px, 4vw, 64px);
                padding-block: clamp(32px, 4vw, 72px);
            }

            .content--home {
                overflow: hidden;
                max-width: none;
                height: 100vh;
                height: var(--app-vh);
                display: flex;
                flex-direction: column;
            }

            /* ========== Mobile overlay nav (<=768px only) ========== */
            .mobile_header {
                display: none;
                position: fixed;
                top: 26px;
                top: max(26px, env(safe-area-inset-top, 0px));
                left: 0;
                right: 0;
                height: 52px;
                padding-left: 26px;
                padding-right: 26px;
                box-sizing: border-box;
                z-index: 1500;
                isolation: isolate;
                flex-direction: row;
                flex-wrap: nowrap;
                align-items: center;
                justify-content: space-between;
            }

            .mobile_brand {
                font-family: var(--display);
                font-weight: 400;
                font-size: 20px;
                line-height: 1;
                letter-spacing: 0.06em;
                color: var(--text);
                text-decoration: none;
            }

            .mobile_brand:hover {
                text-decoration: underline;
                text-underline-offset: 3px;
            }

            .mobile_menu_btn {
                width: 52px;
                height: 52px;
                padding: 0;
                border: none;
                background: transparent;
                color: var(--text);
                font-size: 34px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                -webkit-tap-highlight-color: transparent;
            }

            .mobile_menu_icon--close {
                display: none;
                font-size: 23px;
            }

            .mobile_menu_btn[aria-expanded="true"] .mobile_menu_icon--hamburger {
                display: none;
            }

            .mobile_menu_btn[aria-expanded="true"] .mobile_menu_icon--close {
                display: inline;
            }

            .mobile_overlay {
                position: fixed;
                inset: 0;
                z-index: 1400;
                display: flex;
                align-items: center;
                justify-content: center;
                visibility: hidden;
                opacity: 0;
                pointer-events: none;
                transition: opacity 460ms ease-out, visibility 0s linear 460ms;
            }

            .mobile_overlay[data-open="true"] {
                visibility: visible;
                opacity: 1;
                pointer-events: auto;
                transition: opacity 320ms ease-out, visibility 0s;
            }

            .mobile_overlay_backdrop {
                position: absolute;
                inset: 0;
                background: rgba(255, 255, 255, 0.96);
                backdrop-filter: blur(8px);
                -webkit-backdrop-filter: blur(8px);
                opacity: 1;
            }

            .mobile_overlay_menu {
                position: relative;
                z-index: 1;
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 16px;
                padding: 32px 40px;
                max-height: calc(100vh - 80px);
                max-height: calc(var(--app-dvh) - 80px);
                overflow-y: auto;
                -webkit-overflow-scrolling: touch;
                opacity: 0;
                transform: translateY(4px);
                transition: opacity 300ms ease-out 50ms, transform 300ms ease-out 50ms;
            }

            .mobile_overlay[data-open="true"] .mobile_overlay_menu {
                opacity: 1;
                transform: translateY(0);
            }

            .mobile_overlay_link {
                font-size: 20px;
                color: var(--text);
                text-decoration: none;
            }

            .mobile_overlay_link:hover {
                text-decoration: underline;
                text-underline-offset: 3px;
            }

            .mobile_overlay_link.is_active {
                text-decoration: underline;
                text-underline-offset: 3px;
            }

            .mobile_overlay_link--before_about {
                margin-top: 24px;
            }

            @media (max-width: 768px) {
                .mobile_header {
                    display: flex;
                }

                .sidebar {
                    display: none !important;
                }

                .shell {
                    grid-template-columns: 1fr;
                }

                /* 移动端：隐藏所有滚动条 */
                :global(html)::-webkit-scrollbar,
                :global(body)::-webkit-scrollbar {
                    display: none;
                    width: 0;
                }
                :global(html),
                :global(body) {
                    scrollbar-width: none;
                    -ms-overflow-style: none;
                }

                .content {
                    width: 100%;
                    padding-top: 142px;
                    padding-inline: var(--mobile-padding-x);
                    padding-bottom: 48px;
                    padding-bottom: max(48px, env(safe-area-inset-bottom, 0px));
                }

                /* Home page on mobile: override .content--home to allow scroll + show footer */
                .content--home.mobile_main {
                    overflow-y: auto !important;
                    overflow-x: hidden;
                    height: auto !important;
                    min-height: 100vh;
                    min-height: var(--app-vh);
                    align-items: center;
                }

                /* Override .content > * { max-width: var(--max) } so home_content can be narrow */
                .content--home.mobile_main > :global(*) {
                    max-width: none !important;
                }

                .mobile_main {
                    --mobile-gap: 56px;
                    padding-top: calc(26px + 52px + var(--mobile-gap)) !important;
                    padding-top: calc(max(26px, env(safe-area-inset-top, 0px)) + 52px + var(--mobile-gap)) !important;
                    padding-inline: var(--mobile-padding-x) !important;
                }
            }
        </style>

        <script is:inline>
            (function () {
                const btn = document.getElementById("mobile_menu_btn");
                const overlay = document.getElementById("mobile_overlay");
                const backdrop = document.getElementById("mobile_overlay_backdrop");
                const menu = document.getElementById("mobile_overlay_menu");

                if (!btn || !overlay || !backdrop || !menu) return;

                let scrollLockY = 0;

                function openOverlay() {
                    window.dispatchEvent(new Event("lenis:pause"));
                    overlay.setAttribute("aria-hidden", "false");
                    overlay.setAttribute("data-open", "true");
                    btn.setAttribute("aria-expanded", "true");
                    btn.setAttribute("aria-label", "Close menu");
                    document.body.classList.add("mobile-overlay-open");
                    scrollLockY = window.scrollY;
                    requestAnimationFrame(function () {
                        document.documentElement.style.overflow = "hidden";
                        document.body.style.overflow = "hidden";
                        document.body.style.position = "fixed";
                        document.body.style.top = "-" + scrollLockY + "px";
                        document.body.style.left = "0";
                        document.body.style.right = "0";
                        document.body.style.width = "100%";
                    });
                }

                function closeOverlay() {
                    overlay.setAttribute("data-open", "false");
                    overlay.setAttribute("aria-hidden", "true");
                    btn.setAttribute("aria-expanded", "false");
                    btn.setAttribute("aria-label", "Open menu");
                    overlay.addEventListener("transitionend", function onClosed(e) {
                        if (e.target !== overlay || e.propertyName !== "opacity") return;
                        overlay.removeEventListener("transitionend", onClosed);
                        document.body.classList.remove("mobile-overlay-open");
                        document.documentElement.style.overflow = "";
                        document.body.style.overflow = "";
                        document.body.style.position = "";
                        document.body.style.top = "";
                        document.body.style.left = "";
                        document.body.style.right = "";
                        document.body.style.width = "";
                        window.scrollTo(0, scrollLockY);
                        window.dispatchEvent(new Event("lenis:resume"));
                    }, { once: true });
                }

                btn.addEventListener("click", function () {
                    if (overlay.getAttribute("data-open") === "true") {
                        closeOverlay();
                    } else {
                        openOverlay();
                    }
                });

                backdrop.addEventListener("click", closeOverlay);

                menu.addEventListener("click", function (e) {
                    e.stopPropagation();
                });

                document.addEventListener("keydown", function (e) {
                    if (e.key === "Escape" && overlay.getAttribute("data-open") === "true") {
                        closeOverlay();
                    }
                });

                overlay.addEventListener("click", function (e) {
                    if (e.target === overlay) closeOverlay();
                });
            })();
        </script>

        <!-- Lenis smooth scroll (mobile only, experiment) -->
        <script type="module" src="../scripts/lenis-mobile.js"></script>
    </body>
</html>
